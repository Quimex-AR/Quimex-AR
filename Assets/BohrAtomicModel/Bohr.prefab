--- !u!114 &279413123693529544
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2453521664518523040}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 44e2ee3a751d04be18a97ca9fd05d344, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  title: "Electr\xF3n"
  body: "El electr\xF3n es una part\xEDcula subat\xF3mica con carga negativa que
    se encuentra en movimiento alrededor del n\xFAcleo. Es extremadamente peque\xF1o
    en comparaci\xF3n con protones y neutrones, pero esencial en la formaci\xF3n
    de enlaces qu\xEDmicos y en la conducci\xF3n el\xE9ctrica. En el modelo de Bohr,
    los electrones ocupan niveles de energ\xEDa definidos y pueden saltar de un nivel
    a otro liberando o absorbiendo fotones. Gracias a ellos, los \xE1tomos interact\xFAan
    entre s\xED para formar mol\xE9culas y, en consecuencia, toda la materia que
    conocemos."
  raycastMask:
    serializedVersion: 2
    m_Bits: 4294967295
