--- !u!114 &7787311356286815906
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 4712762173591777040}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 44e2ee3a751d04be18a97ca9fd05d344, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  title: "Prot\xF3n"
  body: "El prot\xF3n es una part\xEDcula subat\xF3mica con carga positiva que se
    localiza en el n\xFAcleo del \xE1tomo. Tiene una masa aproximadamente 1,800 veces
    mayor que la del electr\xF3n y es responsable, junto con los neutrones, de la
    mayor parte de la masa at\xF3mica. El n\xFAmero de protones en un \xE1tomo determina
    a qu\xE9 elemento qu\xEDmico pertenece; por ejemplo, todos los \xE1tomos con
    6 protones son \xE1tomos de carbono. En el modelo de Bohr, los protones forman
    parte del n\xFAcleo central que mantiene a los electrones girando en sus \xF3rbitas."
  raycastMask:
    serializedVersion: 2
    m_Bits: 4294967295
