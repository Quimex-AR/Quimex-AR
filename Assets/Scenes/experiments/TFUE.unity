--- !u!114 &4380160685308934429
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 592646938807249053}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 44e2ee3a751d04be18a97ca9fd05d344, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  title: Modelo de Dalton
  body: "El modelo at\xF3mico de Dalton (1803) conceb\xEDa el \xE1tomo como una esfera
    s\xF3lida, indivisible e indestructible, similar a una pelota de billar. No reconoc\xEDa
    partes internas ni subestructuras. Seg\xFAn Dalton, los \xE1tomos eran las unidades
    m\xE1s peque\xF1as de la materia, completamente macizos y sin componentes internos
    como electrones, protones o neutrones. Este modelo fue posteriormente superado
    cuando se descubrieron las part\xEDculas subat\xF3micas y la estructura interna
    del \xE1tomo."
  raycastMask:
    serializedVersion: 2
    m_Bits: 4294967295
