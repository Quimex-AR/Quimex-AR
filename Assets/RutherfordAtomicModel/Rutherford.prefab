  m_EditorClassIdentifier: 
  modalPanel: {fileID: 0}
  modalText: {fileID: 0}
  textToShow: "Los electrones son part\xEDculas negativas que giran en \xF3rbitas
    circulares alrededor del n\xFAcleo, como planetas alrededor del Sol. Su movimiento
    equilibra la carga positiva del n\xFAcleo, manteniendo al \xE1tomo neutro. Este
    modelo fue el primero en proponer un \xE1tomo mayormente vac\xEDo."
  mainUIGroup: {fileID: 0}
