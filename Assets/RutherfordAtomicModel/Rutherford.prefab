  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Modelo at\xF3mico de Rutherford: \n\nEn 1911, Ernest Rutherford propuso
    que el \xE1tomo tiene un n\xFAcleo peque\xF1o, denso y positivo, donde se concentra
    casi toda la masa, y que los electrones giran a su alrededor en un espacio vac\xEDo.
    \n\nSurgi\xF3 tras su experimento con l\xE1minas de oro, pero no explicaba por
    qu\xE9 los electrones no caen al n\xFAcleo."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
