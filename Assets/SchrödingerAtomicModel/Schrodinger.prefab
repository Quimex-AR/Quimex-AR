--- !u!114 &1128010021225748463
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 650026800053258725}
  m_Enabled: 0
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c920429cb71271543b3c941e1d7999e5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  modalPanel: {fileID: 0}
  modalText: {fileID: 0}
  textToShow: "En el modelo de Schr\xF6dinger, los electrones no giran en \xF3rbitas
    fijas, sino que se distribuyen en nubes llamadas orbitales de probabilidad. Estas
    regiones representan las zonas donde es m\xE1s probable encontrar un electr\xF3n,
    seg\xFAn ecuaciones matem\xE1ticas derivadas de la mec\xE1nica cu\xE1ntica. No
    se puede conocer con certeza su posici\xF3n exacta, solo su probabilidad."
  mainUIGroup: {fileID: 0}
  objectToHide: {fileID: 0}
