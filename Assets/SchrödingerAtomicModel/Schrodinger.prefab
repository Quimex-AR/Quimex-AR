  m_Enabled: 0
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c920429cb71271543b3c941e1d7999e5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  modalPanel: {fileID: 0}
  modalText: {fileID: 0}
  textToShow: "Los neutrones son part\xEDculas sin carga el\xE9ctrica que tambi\xE9n
    se localizan en el n\xFAcleo. Su funci\xF3n principal es estabilizar el n\xFAcleo
    at\xF3mico, ya que ayudan a contrarrestar la repulsi\xF3n entre los protones.
    Su n\xFAmero puede variar entre \xE1tomos del mismo elemento (is\xF3topos)."
  mainUIGroup: {fileID: 0}
  objectToHide: {fileID: 0}
